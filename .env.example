# Copy to .env for local runs. In production these live in GitHub Secrets.
# Nothing in here is ever committed, logged, or sent in a notification.

# --- Leagues (required) ---------------------------------------------------
# The leagueId= number from your ESPN URL.
FF_LEAGUE_1_ID=
FF_LEAGUE_2_ID=
# Optional friendly names used in notifications. Defaults to "League 1"/"League 2".
FF_LEAGUE_1_NAME=
FF_LEAGUE_2_NAME=
# Your team id in each league. Leave blank to auto-detect from SWID.
FF_LEAGUE_1_TEAM_ID=
FF_LEAGUE_2_TEAM_ID=
FF_SEASON=2026

# --- ESPN auth (ONLY needed if a league is private) -----------------------
# These are account-wide bearer cookies for your whole ESPN account. Treat
# them like a password. Extract from browser devtools:
#   Application/Storage > Cookies > espn.com > espn_s2 and SWID
# The agent tests public access first and only uses these if it must.
ESPN_S2=
ESPN_SWID=

# --- Reasoning ------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Notifications --------------------------------------------------------
# Apprise URL. Swap this one line to change delivery channel entirely.
#   ntfy:      ntfy://ntfy.sh/your-hard-to-guess-topic
#   Pushover:  pover://USER_KEY@APP_TOKEN
#   Discord:   discord://webhook_id/webhook_token
FF_NOTIFY_URL=

# --- Optional supplemental sources ---------------------------------------
# FantasyPros consensus rankings. Optional; system degrades gracefully.
FANTASYPROS_API_KEY=

# --- Tuning ---------------------------------------------------------------
# Minimum estimated championship-probability delta (percentage points) for a
# recommendation to be worth interrupting you. Raise it to get fewer alerts.
FF_MIN_CHAMPIONSHIP_DELTA=1.0
# Set to 1 to compute and log but never actually send. Useful for a dry first week.
FF_DRY_RUN=0
